        "type": "object",
        "properties": {
          "input_name": {
            "type": "string",
            "description": "Name of the input"
          },
          "input_uuid": {
            "type": "string",
            "description": "UUID of the input"
          },
          "input_muted": {
            "type": "boolean",
            "description": "Whether the input is muted"
          }
        }
      }
    },
