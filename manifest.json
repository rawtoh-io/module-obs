  "events": [
    {
      "name": "scene.current_changed",
      "summary": "Program scene changed",
      "payload": {
        "type": "object",
        "properties": {
          "scene_name": {
            "type": "string",
            "description": "Name of the scene that was switched to"
          },
          "scene_uuid": {
            "type": "string",
            "description": "UUID of the scene that was switched to"
          }
        }
      }
    },
    {
      "name": "scene.preview_changed",
      "summary": "Preview scene changed (studio mode)",
      "payload": {
        "type": "object",
        "properties": {
          "scene_name": {
            "type": "string",
            "description": "Name of the scene that was switched to"
          },
          "scene_uuid": {
            "type": "string",
            "description": "UUID of the scene that was switched to"
          }
        }
      }
    },
    {
      "name": "scene.list_changed",
      "summary": "Scene list changed",
      "payload": {
        "type": "object",
        "properties": {
          "scenes": {
            "type": "array",
            "description": "Updated array of scenes",
            "items": {
              "type": "object",
              "properties": {
                "scene_index": {
                  "type": "integer",
                  "description": "Index of the scene in the list"
                },
                "scene_name": {
                  "type": "string",
                  "description": "Name of the scene"
                },
                "scene_uuid": {
                  "type": "string",
                  "description": "UUID of the scene"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "scene.created",
      "summary": "A scene was created",
      "payload": {
        "type": "object",
        "properties": {
          "scene_name": {
            "type": "string",
            "description": "Name of the new scene"
          },
          "scene_uuid": {
            "type": "string",
            "description": "UUID of the new scene"
          },
          "is_group": {
            "type": "boolean",
            "description": "Whether the new scene is a group"
          }
        }
      }
    },
    {
      "name": "scene.removed",
      "summary": "A scene was removed",
      "payload": {
        "type": "object",
        "properties": {
          "scene_name": {
            "type": "string",
            "description": "Name of the removed scene"
          },
          "scene_uuid": {
            "type": "string",
            "description": "UUID of the removed scene"
          },
          "is_group": {
            "type": "boolean",
            "description": "Whether the scene was a group"
          }
        }
      }
    },
    {
      "name": "scene.name_changed",
      "summary": "A scene was renamed",
      "payload": {
        "type": "object",
        "properties": {
          "scene_uuid": {
            "type": "string",
            "description": "UUID of the scene"
          },
          "old_scene_name": {
            "type": "string",
            "description": "Old name of the scene"
          },
          "scene_name": {
            "type": "string",
            "description": "New name of the scene"
          }
        }
      }
    },
    {
      "name": "scene_item.enable_state_changed",
      "summary": "A scene item was shown or hidden",
      "payload": {
        "type": "object",
        "properties": {
          "scene_name": {
            "type": "string",
            "description": "Name of the scene the item is in"
          },
          "scene_uuid": {
            "type": "string",
            "description": "UUID of the scene the item is in"
          },
          "scene_item_id": {
            "type": "integer",
            "description": "Numeric ID of the scene item"
          },
          "scene_item_enabled": {
            "type": "boolean",
            "description": "Whether the scene item is enabled (visible)"
          }
        }
      }
    },
    {
      "name": "input.mute_state_changed",
