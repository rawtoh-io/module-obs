            "type": "string",
            "description": "Name of the input"
          },
          "input_uuid": {
            "type": "string",
            "description": "UUID of the input"
          },
          "input_kind": {
            "type": "string",
            "description": "The kind of the input"
          },
          "unversioned_input_kind": {
            "type": "string",
            "description": "The unversioned kind of input (aka no `_v2` stuff)"
          },
          "input_kind_caps": {
            "type": "integer",
            "description": "Bitflag value for the caps that an input supports"
